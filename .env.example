# ============================================================
# 云端理解流水线（阿里云百炼 DashScope）
# ============================================================
# 百炼平台 API Key。留空 -> 流水线自动降级为 mock
DASHSCOPE_API_KEY=
# mock | real。控制「理解/ASR/LLM」三步是否真调云端
PIPELINE_MODE=mock
# 三步所用模型
DS_AUDIO_MODEL=qwen3-omni-flash
DS_ASR_MODEL=qwen3-asr-flash
DS_LLM_MODEL=qwen-plus

# ---- 第四步音乐生成后端 ----
# 后端类型：funmusic（阿里云百炼 fun-music-v1）/ minimax（MiniMax Music）
PIPELINE_MUSIC_BACKEND=funmusic
# mock | real。
PIPELINE_MUSIC_MODE=mock
# MiniMax API Key（使用 minimax 后端时必填）
MINIMAX_API_KEY=
# 是否生成纯音乐（无人声）。true=纯音乐，false=有人声（会演唱歌词）。默认 false
PIPELINE_MUSIC_IS_INSTRUMENTAL=false

# ---- funmusic 后端专用（复用上方 DASHSCOPE_API_KEY，无需单独申请）----
# 模型：fun-music-v1 / fun-music-preview
FUNMUSIC_MODEL=fun-music-v1
# 演唱性别：male / female（仅 fun-music-v1，纯音乐时无效）。默认 female
FUNMUSIC_GENDER=female
# 输出格式：mp3 / wav
FUNMUSIC_FORMAT=mp3

# ============================================================
# 通用
# ============================================================
# 一次最多接收的 prompt 文本长度（保护后端）
MAX_PROMPT_CHARS=500
# 外部设备（ESP32）访问本服务的基准 URL。留空 -> output_url 返回相对路径（浏览器同源可用）；
# 填写后 -> output_url 返回完整 URL（供 ESP32 等外部设备访问）。
# 本机联调: BASE_URL=http://<本机局域网IP>:5000
# 公网 IP 自定义端口: BASE_URL=http://公网IP:8080
# 公网域名 HTTPS: BASE_URL=https://你的域名   （须与 ESP32 的 Host/Port/HTTPS 一致；反代超时建议 ≥360s）
BASE_URL=
# 本地 debug：1/true 开启 Flask debug（公网勿开）
FLASK_DEBUG=0
# 监听端口（仅 python app.py 时有效；gunicorn 用 -b 指定）
PORT=5000
# 说明：音乐成片时长 API 无硬控。LLM 写短歌词 + MiniMax prompt 软提示，目标约 60–90s；
# 请求 duration_sec 会 clamp 到 30–90。不截断音频，保持完整成片。

# ============================================================
# 简易鉴权（防公网盗刷 API 额度）
# ============================================================
# 网页登录密码。留空 = 关闭鉴权（仅适合本机）。公网务必填写。
SITE_PASSWORD=
# 设备/脚本请求头 X-API-Key（或 Authorization: Bearer ...）。
# 留空则与 SITE_PASSWORD 相同。ESP32 固件需写入同一值。
API_ACCESS_KEY=
# Flask Session 签名密钥。公网请设为随机长串（例如 openssl rand -hex 32）。
# 留空则每次进程启动生成临时值（重启后需重新登录）。
SECRET_KEY=
