# ===== Secrets (NEVER commit) =====
.env
.env.local
.env.*.local
*.pem
*.key
secrets.*

# ===== Python =====
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/

# ===== PlatformIO / ESP32 build =====
.pio/
esp32_firmware_idf55/.pio/
esp32_diagnostics/.pio/

# ===== ESP32 firmware releases (large binaries) =====
esp32_firmware_idf55/releases/

# ===== Runtime outputs / logs =====
logs/*.log
logs/*.log.*
logs/**/*.log
logs/**/*.txt
static/uploads/*
!static/uploads/.gitkeep
static/outputs/*
!static/outputs/.gitkeep

# ===== Heavy reference data (regenerable, not source) =====
.board_ref/

# ===== OS / Editor =====
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~
